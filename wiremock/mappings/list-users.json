{
  "request": {
    "method": "GET",
    "urlPath": "/users",
    "queryParameters": {
      "page": {
        "equalTo": "1"
      },
      "page_size": {
        "equalTo": "20"
      }
    },
    "headers": {
      "Authorization": {
        "equalTo": "Bearer dev-token"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "users": [
        {
          "id": 42,
          "name": "Ada Lovelace",
          "email": "ada@example.com"
        }
      ],
      "page": 1,
      "page_size": 20
    }
  }
}
